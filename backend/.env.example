# Copy to backend/.env and fill in. The app REFUSES TO START without a real
# JWT_SECRET unless DEBUG=true (local development only).

# PostgreSQL connection. Append ?sslmode=require for managed/remote databases.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/office_software

# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=

# Comma-separated explicit origins. '*' is rejected at startup.
# Include app://. for the Electron desktop build.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,app://.

# true = local development only (allows the built-in JWT secret, echoes SQL).
DEBUG=false

# Optional: shown by GET /api/v1/version for update checks.
#APP_VERSION=0.0.1

# Optional: one email with full access that bypasses permission checks and
# activity/audit logging ("god mode"). Leave empty to disable (recommended).
#SUPER_ADMIN_EMAIL=

# Used only by scripts/seed_db.py for the initial admin user. If
# ADMIN_PASSWORD is unset, seeding generates a random password and prints it.
#ADMIN_EMAIL=admin@example.com
#ADMIN_PASSWORD=

# Outgoing email (password reset links, task/QA/quote notifications, invoice
# and proposal delivery with PDF attachments). Leave SMTP_HOST empty to
# disable all email. Works with any SMTP provider.
#
# NOTE: many VPS providers (DigitalOcean, Hetzner, ...) block outbound ports
# 25/465/587 by default. Either open a support ticket to unblock, or use a
# relay that listens on an alternate port: Brevo 2525, Resend 2587,
# SendGrid/Mailgun/Postmark 2525.
#
# Gmail (needs a 2FA app password; only works if port 587 is reachable):
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=you@gmail.com
#SMTP_PASSWORD=<16-char app password>
#
# Brevo (free 300/day; SMTP_USER is the generated login from
# "SMTP & API -> SMTP" - NOT your own email; SMTP_FROM must be a sender
# you verified in Brevo):
#SMTP_HOST=smtp-relay.brevo.com
#SMTP_PORT=2525
#SMTP_USER=8xxxxx@smtp-brevo.com
#SMTP_PASSWORD=<generated SMTP key>
#
#SMTP_FROM=Fuorix <no-reply@yourdomain.com>
#SMTP_TLS=true

# Public URL of the web app, used to build links inside emails.
#FRONTEND_URL=https://app.yourdomain.com

# Footer on generated invoice/quote PDFs (address, tax id, contact).
#COMPANY_DETAILS=Fuorix · 123 Main St, Lahore · billing@yourdomain.com
