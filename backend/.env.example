# Copy to backend/.env and fill in. The app REFUSES TO START without a real
# JWT_SECRET unless DEBUG=true (local development only).

# PostgreSQL connection. Append ?sslmode=require for managed/remote databases.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/office_software

# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=

# Comma-separated explicit origins. '*' is rejected at startup.
# Include app://. for the Electron desktop build.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,app://.

# true = local development only (allows the built-in JWT secret, echoes SQL).
DEBUG=false

# Optional: shown by GET /api/v1/version for update checks.
#APP_VERSION=0.0.1

# Optional: one email with full access that bypasses permission checks and
# activity/audit logging ("god mode"). Leave empty to disable (recommended).
#SUPER_ADMIN_EMAIL=

# Used only by scripts/seed_db.py for the initial admin user. If
# ADMIN_PASSWORD is unset, seeding generates a random password and prints it.
#ADMIN_EMAIL=admin@example.com
#ADMIN_PASSWORD=
