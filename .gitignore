# Exclude agent/agents and tasks directories (internal tooling)
/agent/
/agents/
/tasks/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
.env
.env.local
*.egg-info/
.eggs/
dist/
build/
*.egg

# Electron build resources (app icon) must be tracked despite build/ above
!frontend/build/
frontend/build/*
!frontend/build/icon.ico

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
nul

# Build / output
frontend/dist/
frontend/*.tsbuildinfo
frontend/vite.config.d.ts
*.log
.coverage
htmlcov/
.tox/

# Secrets (keep .env.example if present)
.env
!.env.example
